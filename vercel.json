{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bio.deab.com.br"
        }
      ],
      "destination": "/bio-home.html"
    },
    {
      "source": "/:slug([a-zA-Z0-9-]+)",
      "has": [
        {
          "type": "host",
          "value": "bio.deab.com.br"
        }
      ],
      "destination": "/bio.html?u=:slug"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}