{
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "bio.deab.com.br"
        }
      ],
      "dest": "/bio-home.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/:slug((?!.*\\.(?:html|css|js|json|png|svg|ico)$)[^/]+)",
      "has": [
        {
          "type": "host",
          "value": "bio.deab.com.br"
        }
      ],
      "dest": "/api/bio?u=$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}