{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "radar.deab.com.br"
        }
      ],
      "destination": "/radar.html"
    },
    {
      "source": "/:slug((?!api/|radar\\.html|bio\\.html|bio-home\\.html|index\\.html|config\\.json|.*\\..*).*)",
      "has": [
        {
          "type": "host",
          "value": "bio.deab.com.br"
        }
      ],
      "destination": "/api/bio?u=:slug"
    }
  ]
}
