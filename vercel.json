{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bio.deab.com.br"
        }
      ],
      "destination": "/bio-home.html"
    },
    {
      "source": "/:slug((?!api/|bio\\.html|bio-home\\.html|index\\.html|config\\.json|.*\\..*).*)",
      "has": [
        {
          "type": "host",
          "value": "bio.deab.com.br"
        }
      ],
      "destination": "/api/bio?u=:slug"
    }
  ]
}